# Server-side FastAPI URL; keep backend networking off the browser.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Demo-only tenant context; ignored when using institutional OIDC sign-in.
NEXT_PUBLIC_DEMO_TENANT_ID=demo-college

# Configure OIDC values and a randomly generated secret outside source control.
NEXT_PUBLIC_OIDC_ENABLED=false
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
# OIDC_ISSUER=https://your-institution.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
