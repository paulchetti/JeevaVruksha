    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.4.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
