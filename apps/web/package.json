{
  "name": "jeeva-vruksha-web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib components auth.ts types",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" app/styles.css \"lib/**/*.ts\" \"components/**/*.tsx\" auth.ts \"types/**/*.d.ts\"",
