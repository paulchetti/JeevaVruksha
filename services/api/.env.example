# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Configure this locally before applying database migrations.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/jeeva_vruksha

# The demo mode is only valid for local development. Production must use OIDC.
APP_ENV=development
AUTH_MODE=demo
# OIDC_ISSUER=https://your-institution.example
# OIDC_AUDIENCE=jeeva-api
# OIDC_JWKS_URL=https://your-institution.example/.well-known/jwks.json
